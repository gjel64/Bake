{
  "expo": {
    "name": "Bake",
    "slug": "bake",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F2F7",
    "splash": {
      "backgroundColor": "#F2F2F7",
      "resizeMode": "contain",
      "dark": {
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#54D6A6"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bake.app",
      "allowBackup": true
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "111fc82c-775d-4901-820b-9f948599a8de"
      }
    }
  }
}
